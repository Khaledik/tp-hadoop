# Stage 1: download and extract binaries
FROM alpine:3.20 AS builder

ARG HADOOP_VERSION=3.3.6
ARG HBASE_VERSION=2.5.15
ARG ZK_VERSION=3.8.6
# 4.1.0 (et non 4.2.x) : Hive 4.2 exige Java 21, l'image tourne en Java 17
ARG HIVE_VERSION=4.1.0
RUN apk add --no-cache curl

RUN curl -fsSL https://dlcdn.apache.org/hadoop/common/hadoop-$HADOOP_VERSION/hadoop-$HADOOP_VERSION.tar.gz \
    | tar xz -C /opt && mv /opt/hadoop-$HADOOP_VERSION /opt/hadoop

RUN curl -fsSL https://dlcdn.apache.org/hbase/$HBASE_VERSION/hbase-$HBASE_VERSION-hadoop3-bin.tar.gz \
    | tar xz -C /opt && mv /opt/hbase-$HBASE_VERSION-hadoop3 /opt/hbase

RUN curl -fsSL https://dlcdn.apache.org/zookeeper/zookeeper-$ZK_VERSION/apache-zookeeper-$ZK_VERSION-bin.tar.gz \
    | tar xz -C /opt && mv /opt/apache-zookeeper-$ZK_VERSION-bin /opt/zookeeper

# 4.1.0 n'est plus sur dlcdn (seul miroir des 4.2.x) : archive.apache.org
RUN curl -fsSL https://archive.apache.org/dist/hive/hive-$HIVE_VERSION/apache-hive-$HIVE_VERSION-bin.tar.gz \
    | tar xz -C /opt && mv /opt/apache-hive-$HIVE_VERSION-bin /opt/hive

RUN rm -rf \
    /opt/hadoop/share/doc \
    /opt/hbase/docs \
    /opt/zookeeper/docs \
    /opt/hive/docs \
    /opt/hive/jdbc \
    /opt/hive/hcatalog/share/doc \
  && find /opt \( -name "*.bat" -o -name "*.cmd" -o -name "*.ps1" -o -name "*.a" \) -delete

# Stage 2: runtime image
FROM debian:bookworm-slim

LABEL description="Hadoop 3.3.6 + HBase 2.5.15 + ZooKeeper 3.8.6 + Hive 4.1.0 - Learning Cluster"
LABEL maintainer="Hadoop Docker Learning"

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk
ENV HADOOP_HOME=/opt/hadoop
ENV HBASE_HOME=/opt/hbase
ENV ZK_HOME=/opt/zookeeper
ENV HIVE_HOME=/opt/hive
ENV HADOOP_CONF_DIR=$HADOOP_HOME/etc/hadoop
ENV HBASE_CONF_DIR=$HBASE_HOME/conf
ENV HIVE_CONF_DIR=$HIVE_HOME/conf
ENV HDFS_NAMENODE_USER=root
ENV HDFS_DATANODE_USER=root
ENV HDFS_SECONDARYNAMENODE_USER=root
ENV YARN_RESOURCEMANAGER_USER=root
ENV YARN_NODEMANAGER_USER=root
ENV PATH=$PATH:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$HBASE_HOME/bin:$ZK_HOME/bin:$HIVE_HOME/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jdk-headless \
        openssh-server openssh-client \
        netcat-openbsd nano \
        python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture) /usr/lib/jvm/java-17-openjdk

RUN python3 -m pip install --no-cache-dir --break-system-packages \
        pandas matplotlib happybase thriftpy2

RUN ssh-keygen -t rsa -P '' -f /root/.ssh/id_rsa && \
    cat /root/.ssh/id_rsa.pub >> /root/.ssh/authorized_keys && \
    chmod 600 /root/.ssh/authorized_keys

COPY --from=builder /opt/hadoop $HADOOP_HOME
COPY --from=builder /opt/hbase $HBASE_HOME
COPY --from=builder /opt/zookeeper $ZK_HOME
COPY --from=builder /opt/hive $HIVE_HOME

RUN mkdir -p /data/hdfs/namenode /data/hdfs/datanode /data/zookeeper /opt/scripts /home/src /var/run/sshd

COPY config/core-site.xml $HADOOP_CONF_DIR/core-site.xml
COPY config/hdfs-site.xml $HADOOP_CONF_DIR/hdfs-site.xml
COPY config/mapred-site.xml $HADOOP_CONF_DIR/mapred-site.xml
COPY config/yarn-site.xml $HADOOP_CONF_DIR/yarn-site.xml
COPY config/hbase-site.xml $HBASE_CONF_DIR/hbase-site.xml
COPY config/hive-site.xml $HIVE_CONF_DIR/hive-site.xml
COPY config/zoo.cfg $ZK_HOME/conf/zoo.cfg
COPY config/datanodes $HADOOP_CONF_DIR/workers
COPY config/datanodes $HBASE_CONF_DIR/regionservers
COPY scripts/entrypoint.sh /opt/scripts/entrypoint.sh
COPY scripts/master/ /home/

RUN chmod +x /opt/scripts/entrypoint.sh /home/*.sh && \
    echo "alias clear='printf \"\\033c\"'" >> /etc/bashrc

WORKDIR /home

EXPOSE 9870 8088 8042 16010 2181 9000 9090 9091 10000 10002

ENTRYPOINT ["/opt/scripts/entrypoint.sh"]
