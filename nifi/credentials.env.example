# Login de l'interface NiFi (https://localhost:8443/nifi).
#
#   cp nifi/credentials.env.example nifi/credentials.env
#   puis remplacer m_ot-de-passe-du-cours-2026 par la valeur choisie
#
# credentials.env n'est JAMAIS versionné (.gitignore) : aucun secret en dur
# dans git. Sans ce fichier, NiFi négocie un couple aléatoire à chaque
# création du conteneur et l'écrit dans `docker logs hadoop-nifi`.
#
# ⚠ Le mot de passe DOIT faire au moins 12 caractères. En dessous, NiFi
#   rejette la valeur silencieusement et retombe sur le couple aléatoire :
#   l'écran de login refuse alors ce que le cours avait annoncé.
SINGLE_USER_CREDENTIALS_USERNAME=etudiant
SINGLE_USER_CREDENTIALS_PASSWORD=m_ot-de-passe-du-cours-2026
